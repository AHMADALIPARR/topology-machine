(set-logic QF_BV)
(declare-fun s () (_ BitVec 3))
(define-fun a () (_ BitVec 1) ((_ extract 0 0) s))
(define-fun b () (_ BitVec 1) ((_ extract 1 1) s))
(define-fun c () (_ BitVec 1) ((_ extract 2 2) s))
(define-fun cx ((x (_ BitVec 3))) (_ BitVec 3)
 (bvxor x (bvshl (bvand x #b001) #b001)))
(define-fun ccx ((x (_ BitVec 3))) (_ BitVec 3)
 (bvxor x (bvshl (bvand (bvand x #b001) (bvlshr (bvand x #b010) #b001)) #b010)))
(define-fun fw ((x (_ BitVec 3))) (_ BitVec 3)
 (ite (= (bvand x #b001) #b001)
   (bvor (bvand x #b001) (bvor (bvshl (bvand x #b010) #b001) (bvlshr (bvand x #b100) #b001))) x))
(assert (or (distinct (cx (cx s)) s) (distinct (ccx (ccx s)) s) (distinct (fw (fw s)) s)))
(check-sat)
